# Server
APP_NAME=estatein-ai-service
APP_ENV=production
HOST=0.0.0.0
PORT=8001
AI_SERVICE_PORT=8001
AI_SERVICE_PUBLISHED_PORT=8001
AI_SERVICE_MEMORY_LIMIT=3072m
AI_WEB_CONCURRENCY=1
AI_RUN_MIGRATIONS=true
DOCKER_NETWORK_NAME=real_estate_network
AI_SERVICE_IMAGE=ghcr.io/<owner>/<ai-service-repo>/ai-service:latest

# DB
DATABASE_URL=postgresql+asyncpg://myuser:mypassword@postgres:5432/realestate
PGVECTOR_URL=postgresql+psycopg://myuser:mypassword@postgres:5432/realestate

# Embedding
EMBED_MODEL=intfloat/multilingual-e5-base
EMBED_DIM=768
EMBED_DEVICE=cpu
EMBED_QUERY_PREFIX=query: 
EMBED_DOCUMENT_PREFIX=passage: 

# Retrieval
TOP_K_DEFAULT=16
PGVECTOR_COLLECTION=post_embeddings__multilingual_e5_base_ghr1
PGVECTOR_COLLECTION_PLANNING=planning_documents__multilingual_e5_base_ghr1__planning_hierarchical_parent_context
PLANNING_CHUNKING_MODE=planning_hierarchical_parent_context
RAG_RETRIEVER_MODE=hybrid
RAG_HYBRID_SEM_MULTIPLIER=3
RAG_HYBRID_LEX_MULTIPLIER=3
RAG_HYBRID_RRF_K=60
RAG_HYBRID_SEM_WEIGHT=1.0
RAG_HYBRID_LEX_WEIGHT=0.9
PLANNING_USE_FACT_SUBQUERIES=false

# Listing chunking (effective for new ingest/re-ingest)
LISTING_CHUNK_SIZE=900
LISTING_CHUNK_OVERLAP=120

# OCR fallback path for scanned PDFs when pypdf cannot extract usable text.
PLANNING_PDF_OCR_FALLBACK_ENABLED=true
# 0 means OCR all pages. Keep this small on 2 vCPU / 4 GB VPS.
PLANNING_PDF_OCR_MAX_PAGES=10
PLANNING_PDF_OCR_RENDER_SCALE=1.25
# Soft timeout per document ingest (seconds). 0 means no timeout.
PLANNING_INGEST_SOFT_TIMEOUT_SECONDS=180
# When true, ignore soft-timeout/max-page truncation and require full extraction.
PLANNING_INGEST_REQUIRE_FULL=false
# OCR progress log interval by processed page count. 0 disables periodic progress logs.
PLANNING_OCR_PROGRESS_EVERY_PAGES=5

# Planning ingest HTTP/TLS options.
# Keep SSL verify enabled in production. If source uses custom CA, set PLANNING_INGEST_CA_BUNDLE.
# Only for local/dev troubleshooting: set PLANNING_INGEST_SSL_VERIFY=false.
PLANNING_INGEST_SSL_VERIFY=true
PLANNING_INGEST_CA_BUNDLE=
# Optional local/dev fallback: if SSL verify fails, retry once with verify=false.
PLANNING_INGEST_SSL_ALLOW_INSECURE_FALLBACK=false

# Optional: gọi BE để fetch posts khi ingest
ESTATEIN_API_BASE_URL=http://core:3001
OPENAI_API_KEY=
# Use for Judge Model
DEEPSEEK_API_KEY=

OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
