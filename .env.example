# Server
APP_NAME=estatein-ai-service
APP_ENV=dev
HOST=127.0.0.1
PORT=8001

# DB
DATABASE_URL=

# Embedding
EMBED_MODEL=intfloat/multilingual-e5-small
EMBED_DIM=384
EMBED_DEVICE=cpu

# Retrieval
TOP_K_DEFAULT=12

# Optional: gọi BE để fetch posts khi ingest
ESTATEIN_API_BASE_URL=http://localhost:3001
OPENAI_API_KEY=

OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
