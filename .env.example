# Server
APP_NAME=estatein-ai-service
APP_ENV=dev
HOST=127.0.0.1
PORT=8001

# DB
DATABASE_URL=

# Embedding
EMBED_MODEL=intfloat/multilingual-e5-small
EMBED_DIM=384
EMBED_DEVICE=cpu

# Retrieval
TOP_K_DEFAULT=12
PGVECTOR_COLLECTION=post_embeddings
PGVECTOR_COLLECTION_PLANNING=planning_documents

# Planning ingest: skip Docling for large PDFs to avoid CPU/RAM spikes on local machines.
# Set 0 to always try Docling.
PLANNING_DOCLING_MAX_PAGES=20
# Optional: disable Docling completely and always use splitter-based chunking.
PLANNING_DOCLING_ENABLED=true
# For scanned PDFs (no text layer), prefer OCR fallback directly.
# Set true only if you intentionally want Docling first for scanned docs.
PLANNING_SCANNED_PDF_USE_DOCLING_FIRST=false
# Skip Docling when PDF payload is larger than this many bytes (default 15MB).
PLANNING_DOCLING_MAX_PDF_BYTES=15728640
# OCR large scanned PDFs in smaller page batches to reduce bad_alloc risk.
PLANNING_DOCLING_BATCH_PAGES=6
# If Docling throws std::bad_alloc once, disable Docling for the current process.
PLANNING_DOCLING_DISABLE_AFTER_BAD_ALLOC=true

# Fallback OCR path for scanned PDFs when pypdf/docling cannot extract text.
PLANNING_PDF_OCR_FALLBACK_ENABLED=true
# 0 means OCR all pages.
PLANNING_PDF_OCR_MAX_PAGES=0
PLANNING_PDF_OCR_RENDER_SCALE=1.25
# Soft timeout per document ingest (seconds). 0 means no timeout.
PLANNING_INGEST_SOFT_TIMEOUT_SECONDS=0
# When true, ignore soft-timeout/max-page truncation and require full extraction.
PLANNING_INGEST_REQUIRE_FULL=false
# OCR progress log interval by processed page count. 0 disables periodic progress logs.
PLANNING_OCR_PROGRESS_EVERY_PAGES=5

# Planning ingest HTTP/TLS options.
# Keep SSL verify enabled in production. If source uses custom CA, set PLANNING_INGEST_CA_BUNDLE.
# Only for local/dev troubleshooting: set PLANNING_INGEST_SSL_VERIFY=false.
PLANNING_INGEST_SSL_VERIFY=true
PLANNING_INGEST_CA_BUNDLE=
# Optional local/dev fallback: if SSL verify fails, retry once with verify=false.
PLANNING_INGEST_SSL_ALLOW_INSECURE_FALLBACK=false

# Optional: gọi BE để fetch posts khi ingest
ESTATEIN_API_BASE_URL=http://localhost:3001
OPENAI_API_KEY=

OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
